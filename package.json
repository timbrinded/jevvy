{
  "name": "jevvy",
  "version": "0.1.0",
  "description": "Source-linked comment, function and test analysis for Pi using Jev",
  "keywords": [
    "code-quality",
    "jev",
    "pi-extension",
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timbrinded/jevvy.git"
  },
  "files": [
    "src",
    "dist",
    "native",
    "schemas",
    "examples",
    "README.md",
    "docs/packs.md",
    "docs/pack-experiments.md",
    "docs/packs-verification.md",
    "docs/experiments",
    "docs/contracts.md",
    "docs/verification.md",
    "docs/evaluation.md",
    "docs/exploratory-assessment.md",
    "docs/exploratory-retest.md",
    "docs/images",
    "docs/ui-verification.md",
    "docs/ui-exploration.md",
    "docs/handoff-verification.md",
    "docs/cookbook-assessment.md",
    "docs/jevvy-product-sheet.md"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/engine.js",
    "./contracts": "./dist/contracts.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "smoke": "node scripts/pi-check.mjs",
    "smoke:live": "node scripts/pi-check.mjs --live",
    "smoke:packs": "node scripts/pi-packs-check.mjs",
    "smoke:packs:live": "node scripts/pi-packs-check.mjs --live",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm test && pnpm run build",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@ast-grep/lang-python": "0.0.6",
    "@ast-grep/lang-rust": "0.0.7",
    "@ast-grep/napi": "0.45.3",
    "@typesafe-ai/sdk": "0.6.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.86.1",
    "@earendil-works/pi-coding-agent": "0.86.1",
    "@earendil-works/pi-tui": "0.86.1",
    "@types/node": "^26.6.2",
    "oxfmt": "^0.69.0",
    "oxlint": "^1.84.0",
    "typebox": "1.3.27",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "node": "^26.0.0"
  },
  "packageManager": "pnpm@11.26.0",
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  }
}
